<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Clean 3D Space</title>
    <style>
        body { margin: 0; overflow: hidden; background: #000; font-family: monospace; color: #00f3ff; }
        #ui { position: absolute; top: 15px; left: 15px; background: rgba(0,0,0,0.8); padding: 15px; border-radius: 8px; border: 1px solid #00f3ff; z-index: 10; }
        input, button { padding: 6px; margin-top: 5px; background: #111; color: #00f3ff; border: 1px solid #00f3ff; border-radius: 4px; }
        button { cursor: pointer; background: #ff007f; color: #fff; border: none; font-weight: bold; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; background: #ff007f; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
    </style>
    <!-- Three.js для 3D та PeerJS для гри вдвох -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
</head>
<body>

<div id="ui">
    <div><b>ПЛЕЙС ДЛЯ ДВОХ</b></div>
    <div style="font-size: 12px; color: #aaa; margin: 5px 0;">Клікни по екрану → WASD для ходьби</div>
    <div>Твій ID: <b id="my-id" style="color:#ff007f;">Підключення...</b></div>
    <input type="text" id="friend-id" placeholder="ID друга"><br>
    <button onclick="connectToFriend()">Підключитися</button>
    <div id="status" style="font-size: 11px; margin-top: 5px; color: #0f0;"></div>
</div>

<div id="crosshair"></div>

<script>
    // 1. СЦЕНА, КАМЕРА ТА РЕНДЕР
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x050510);
    scene.fog = new THREE.FogExp2(0x050510, 0.03);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    document.body.appendChild(renderer.domElement);

    // Освітлення
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0x00f3ff, 1);
    dirLight.position.set(10, 20, 10);
    scene.add(dirLight);

    // 2. ЗЕМЛЯ ТА СТІНИ (щоб не випасти за межі карти)
    const floorGeo = new THREE.PlaneGeometry(60, 60);
    const floorMat = new THREE.MeshStandardMaterial({ color: 0x151525, roughness: 0.8 });
    const floor = new THREE.Mesh(floorGeo, floorMat);
    floor.rotation.x = -Math.PI / 2;
    scene.add(floor);

    // Сітка на підлозі для краси
    const grid = new THREE.GridHelper(60, 30, 0xff007f, 0x333355);
    grid.position.y = 0.01;
    scene.add(grid);

    // 3. СТАН ТА КЕРУВАННЯ ГРАВЦЕМ
    const player = {
        x: 0,
        z: 5,
        height: 1.6,
        speed: 0.12
    };

    camera.position.set(player.x, player.height, player.z);

    let yaw = 0;   // Поворот вліво-вправо
    let pitch = 0; // Поворот вгору-вниз (жорстко обмежений, щоб не перевертатися)
    const keys = {};

    renderer.domElement.addEventListener('click', () => {
        renderer.domElement.requestPointerLock();
    });

    document.addEventListener('mousemove', (e) => {
        if (document.pointerLockElement === renderer.domElement) {
            yaw -= e.movementX * 0.002;
            pitch -= e.movementY * 0.002;
            // Обмежуємо кут огляду по вертикалі, щоб камера не крутилася навколо
            pitch = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, pitch));
        }
    });

    document.addEventListener('keydown', (e) => { keys[e.code] = true; });
    document.addEventListener('keyup', (e) => { keys[e.code] = false; });

    // 4. МУЛЬТИПЛЕЄР ЧЕРЕЗ PEERJS
    const peer = new Peer();
    let conn = null;

    // Модель друга (інший гравець)
    const friendMesh = new THREE.Mesh(
        new THREE.BoxGeometry(0.8, 1.8, 0.8),
        new THREE.MeshStandardMaterial({ color: 0xff007f, emissive: 0x330015 })
    );
    friendMesh.visible = false;
    scene.add(friendMesh);

    peer.on('open', (id) => {
        document.getElementById('my-id').innerText = id;
    });

    peer.on('connection', (connection) => {
        conn = connection;
        setupConnection();
    });

    function connectToFriend() {
        const friendId = document.getElementById('friend-id').value.trim();
        if (friendId) {
            conn = peer.connect(friendId);
            setupConnection();
        }
    }

    function setupConnection() {
        document.getElementById('status').innerText = "З'єднано з другом!";
        friendMesh.visible = true;
        conn.on('data', (data) => {
            friendMesh.position.set(data.x, data.y - 0.9, data.z);
        });
    }

    // 5. ГОЛОВНИЙ ІГРОВИЙ ЦИКЛ
    function animate() {
        requestAnimationFrame(animate);

        // Розрахунок напрямку руху відносно погляду камери
        const moveDir = new THREE.Vector3();
        if (keys['KeyW']) moveDir.z -= 1;
        if (keys['KeyS']) moveDir.z += 1;
        if (keys['KeyA']) moveDir.x -= 1;
        if (keys['KeyD']) moveDir.x += 1;
        moveDir.normalize();
        moveDir.applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);

        // Змінюємо позицію з перевіркою меж карти (щоб не вийти в нікуди)
        player.x += moveDir.x * player.speed;
        player.z += moveDir.z * player.speed;
        player.x = Math.max(-28, Math.min(28, player.x));
        player.z = Math.max(-28, Math.min(28, player.z));

        // Оновлюємо положення камери
        camera.position.set(player.x, player.height, player.z);
        camera.rotation.order = 'YXZ';
        camera.rotation.y = yaw;
        camera.rotation.x = pitch;

        // Відправляємо координати другу
        if (conn && conn.open) {
            conn.send({ x: player.x, y: player.height, z: player.z });
        }

        renderer.render(scene, camera);
    }

    animate();

    // Адаптація під розмір вікна
    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });
</script>
</body>
</html>
